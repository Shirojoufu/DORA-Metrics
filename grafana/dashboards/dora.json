        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Recovery time (weekly median)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "dora-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "dora-postgres"
          },
          "refId": "A",
          "rawQuery": true,
          "format": "time_series",
          "editorMode": "code",
          "rawSql": "select greatest(week::timestamptz, $__timeFrom()::timestamptz) as time, median_recovery_hours * 3600 as \"Recovery time\" from weekly_metrics where repo = '$repo' and environment = '$environment' and week::timestamptz + interval '7 days' > $__timeFrom()::timestamptz and week::timestamptz < $__timeTo()::timestamptz order by 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
